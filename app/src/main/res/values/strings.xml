    <!-- Quick Help -->
    <string name="help_title">Quick Help</string>
    <string name="help_q1">Why isn\'t the message sending?</string>
    <string name="help_a1">Sada depends on distance. Try getting closer to your friend or go to an open area/balcony to strengthen the signal.</string>
    <string name="help_q2">What does the red color mean?</string>
    <string name="help_a2">The flashing red color indicates an SOS distress signal. Someone nearby needs immediate help.</string>
    <string name="help_q3">How do I know if I\'m connected?</string>
    <string name="help_a3">Check the number next to the \"Neighbors\" icon at the top. Higher numbers mean a stronger network and faster message delivery.</string>
    <string name="help_close">Got it</string>
