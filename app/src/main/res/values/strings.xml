    <!-- Permissions Rationale -->
    <string name="perm_rationale_title">Why these permissions?</string>
    <string name="perm_rationale_desc">Sada works entirely without internet, and to achieve this, we need technical permissions. We guarantee total privacy: no tracking, no central servers, and no access to your personal data.</string>
    <string name="perm_nearby_title">Nearby Devices &amp; WiFi</string>
    <string name="perm_nearby_desc">Required to find nearby phones to exchange messages. Android might technically request \"Location\" to enable WiFi, but we never use GPS to track you.</string>
    <string name="perm_camera_title">Camera</string>
    <string name="perm_camera_desc">Only used to scan your friends\' QR codes to add them safely.</string>
    <string name="perm_mic_title">Microphone</string>
    <string name="perm_mic_desc">Only used to record and send voice messages within chats.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_desc">To let you know when new messages arrive in the background.</string>
    <string name="perm_button_grant">I Understand, Let\'s Start</string>

