    <!-- Permissions Rationale -->
    <string name="perm_rationale_title">لماذا نحتاج هذه الصلاحيات؟</string>
    <string name="perm_rationale_desc">تطبيق صدى يعمل بالكامل بدون إنترنت، ولتحقيق ذلك نحتاج لبعض الصلاحيات التقنية. نحن نضمن لك الخصوصية التامة: لا تتبع، لا خوادم مركزية، ولا وصول لبياناتك الشخصية.</string>
    <string name="perm_nearby_title">اكتشاف الجيران</string>
    <string name="perm_nearby_desc">مهم لنقدر نلاقي الموبايلات اللي جنبك ونتبادل الرسائل معها. أندرويد بيطلب "الموقع" تقنياً لنقدر نفتح الواي فاي، بس نحنا ما بنعرف وينك ولا بنراقبك أبداً.</string>
    <string name="perm_camera_title">الكاميرا</string>
    <string name="perm_camera_desc">تستخدم فقط لمسح كود الـ QR الخاص بأصدقائك لإضافتهم بأمان.</string>
    <string name="perm_mic_title">الميكروفون</string>
    <string name="perm_mic_desc">يستخدم فقط لتسجيل وإرسال الرسائل الصوتية داخل المحادثات.</string>
    <string name="perm_notifications_title">الإشعارات</string>
    <string name="perm_notifications_desc">لإخبارك بوجود رسائل جديدة وصلت لجهازك في الخلفية.</string>
    <string name="perm_button_grant">أوافق، دعنا نبدأ</string>

    <!-- Home Banner -->
    <string name="banner_permissions_missing">الشبكة تعمل بنطاق محدود</string>
    <string name="banner_permissions_desc">يرجى منح الصلاحيات المطلوبة لضمان وصول الرسائل من الأجهزة البعيدة.</string>
    <string name="banner_permissions_button">منح الصلاحيات</string>
    
    <!-- Quick Help -->
    <string name="help_title">مساعدة سريعة</string>
    <string name="help_q1">ليش ما عم توصل الرسالة؟</string>
    <string name="help_a1">صدى بيعتمد على المسافة. جرب تقرب من رفيقك أو تطلع عالبلكون (بمكان مكشوف) لتقوى الإشارة.</string>
    <string name="help_q2">شو يعني اللون الأحمر؟</string>
    <string name="help_a2">اللون الأحمر الوميض يعني نداء استغاثة (SOS). حدا قريب منك محتاج مساعدة فورية.</string>
    <string name="help_q3">كيف بعرف إني واصل؟</string>
    <string name="help_a3">شوف الرقم اللي جنب أيقونة "الجيران" فوق. كل ما زاد الرقم، زادت قوة شبكتك وسرعة وصول الرسائل.</string>
    <string name="help_close">فهمت</string>
